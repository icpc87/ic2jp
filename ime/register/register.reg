Windows Registry Editor Version 5.00

; ============================================================
; IC2JP Live Conversion IME — manual COM registration fallback
;
; Use this file ONLY if regsvr32 ic2jp_ime.dll fails.
;
; Before importing:
;   1. Replace ALL occurrences of {A1B2C3D4-E5F6-7890-ABCD-EF1234567890}
;      with your actual CLSID_IC2JP_IME value.
;   2. Update the DLL path in InprocServer32 to match your install location.
;   3. Run "reg import register.reg" from an elevated command prompt.
;
; TSF language profile registration (ITfInputProcessorProfiles) cannot be
; done through a .reg file — it requires DllRegisterServer to be called via
; regsvr32 or a custom installer.
; ============================================================

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}]
@="IC2JP Live Conversion IME"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}\InprocServer32]
@="C:\\Program Files\\IC2JP\\ic2jp_ime.dll"
"ThreadingModel"="Apartment"
